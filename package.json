{
  "name": "watchlist",
  "productName": "Watchlist",
  "version": "4.3.0",
  "description": "قائمة المشاهدة — نسخة الديسكتوب",
  "main": "main.js",
  "partyServer": "wss://watchlist-party.gaser-7afez.workers.dev",
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.mjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.watchlist.desktop",
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Watchlist-Setup-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app.html",
      "app.js",
      "popupblock.js",
      "mysteryhide.js",
      "icon*.png",
      "icon.ico",
      "party.js",
      "party-server/src/protocol.mjs"
    ]
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "electron-winstaller": false
  }
}
